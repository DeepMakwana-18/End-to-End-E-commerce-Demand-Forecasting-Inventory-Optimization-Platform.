# ============================================
# Environment Configuration
# AI-Powered E-commerce Demand Forecasting
# & Inventory Optimization Platform
# ============================================

# ---- Application ----
APP_NAME=DemandForecaster
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=your-super-secret-key-change-in-production

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=demandforecaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/demandforecaster

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Frontend ----
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=DemandForecaster

# ---- ML ----
ML_MODEL_PATH=./ml/models
ML_RETRAIN_SCHEDULE=0 2 * * *

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
