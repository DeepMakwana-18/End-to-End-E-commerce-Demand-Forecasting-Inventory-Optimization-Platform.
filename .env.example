# Application
APP_NAME="Titan Supply Chain AI"
APP_ENV=production
APP_DEBUG=False
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@postgres:5432/demandforecaster
POSTGRES_DB=demandforecaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

# Redis
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-redis-password

# Flower
FLOWER_USER=admin
FLOWER_PASSWORD=your-flower-password

# JWT
JWT_SECRET_KEY=your-secure-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging / Observability
SENTRY_DSN=""
LOG_JSON=True
LOG_LEVEL=INFO

# Worker Settings
WORKER_COUNT=4
